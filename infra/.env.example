# LLM
OLLAMA_MODEL=smollm2:135m
LLM_QUEUE_MAX_SIZE=10
SERVICENAME=llm

# Message broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Agent service
MESSAGE_MAX_TOKENS=150
VOTE_MAX_TOKENS=50

# Game settings
PHASE_DURATION_SECONDS=60
VOTE_TIMEOUT_SECONDS=30
AGENT_COUNT=10
MAFIA_COUNT=3
AGENT_HOST_PATTERN=mafia-ai-agent-{n}

# Services
ORCHESTRATOR_URL=http://mafia-ai-orchestrator:8081
UNIFIED_AGENT_URL=http://mafia-ai-unified-agent:8082
LLM_URL=http://mafia-ai-llm:8080
OLLAMA_URL=http://mafia-ai-ollama:11434
AMQP_URL=amqp://guest:guest@mafia-ai-rabbitmq:5672/
OTEL_EXPORTER_OTLP_ENDPOINT=http://mafia-ai-otel-collector:4317

# Telemetry
OTEL_SDK_DISABLED=false
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_USERS_DEFAULT_THEME=dark