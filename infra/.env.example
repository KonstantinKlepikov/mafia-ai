# LLM
OLLAMA_MODEL=ministral-3
LLM_QUEUE_MAX_SIZE=10
OLLAMA_URL=http://mafia-ai-ollama:11434
SERVICENAME=llm

# Message broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
AMQP_URL=amqp://guest:guest@mafia-ai-rabbitmq:5672/

# Vector database
VECTOR_DB_URL=http://vectordb:6333

# Agent service
AGENT_HTTP_PORT=8100
LLM_URL=http://mafia-ai-llm:8080
VECTORDB_HOST=mafia-ai-vectordb
VECTORDB_PORT=8000

# Game settings
PHASE_DURATION_SECONDS=60
VOTE_TIMEOUT_SECONDS=30
AGENT_COUNT=10
MAFIA_COUNT=2
AGENT_HOST_PATTERN=mafia-ai-agent-{n}

# Admin panel
ORCHESTRATOR_URL=http://mafia-ai-orchestrator:8081
